{
  "manifest_version": 3,
  "key": "",
  "name": "__MSG_extensionName__",
  "version": "0.1.5",
  "description": "__MSG_extensionDescription__",
  "permissions": [
    "activeTab",
    "alarms",
    "tabs",
    "tabGroups",
    "scripting",
    "sidePanel",
    "storage",
    "downloads",
    "debugger",
    "geolocation",
    "offscreen",
    "clipboardWrite",
    "notifications",
    "declarativeNetRequest",
    "unlimitedStorage"
  ],
  "optional_permissions": [
    "history",
    "bookmarks",
    "desktopCapture",
    "downloads.open"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';",
    "sandbox": "sandbox allow-scripts; script-src 'self' 'unsafe-eval' blob:; worker-src blob:; child-src blob:;"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "sandbox": {
    "pages": [
      "runner-sandbox.html"
    ]
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*", "http://localhost/*"],
      "js": ["content/mcp-connect-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/session-export-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/article-extractor.js",
        "content/content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "action": {
    "default_title": "__MSG_extensionName__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      }
    },
    "open-model-preset-switcher": {
      "suggested_key": {
        "default": "Ctrl+Shift+M",
        "mac": "Command+Shift+M"
      },
      "description": "__MSG_switchModel__"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "default_locale": "en"
}
