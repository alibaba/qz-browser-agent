  "steps": [
    { "action": "assert", "expect": "collapsedLane", "lane": "tool" },
    { "action": "expandGroup", "group": 0, "label": "展开错误工具组" },
    { "action": "assert", "expect": "expandedLane", "lane": "tool" },
    { "action": "assert", "expect": "navText", "equals": "2/3" },
    { "action": "assert", "expect": "activeText", "includes": "操作元素" },
    { "action": "assert", "expect": "selectorText", "selector": ".tool-timeline-slot", "includes": "元素引用已过期" },
    { "action": "assert", "expect": "selectorText", "selector": ".tool-error-message", "includes": "Element target is stale or unknown." },
    { "action": "assert", "expect": "selectorText", "selector": ".tool-timeline-slot", "includes": "uid:btn-save" },
    { "action": "click", "selector": ".tool-timeline-raw-btn:not(.hidden)", "label": "查看标准错误与恢复提示" },
    { "action": "assert", "expect": "selectorText", "selector": ".tool-timeline-raw-panel:not(.hidden)", "includes": "元素引用已过期" },
    { "action": "assert", "expect": "selectorText", "selector": ".tool-timeline-raw-panel:not(.hidden)", "includes": "Take a fresh get_ax_tree snapshot, then retry." },
    { "action": "assert", "expect": "selectorText", "selector": ".tool-timeline-raw-panel:not(.hidden)", "includes": "uid:btn-save" },
    { "action": "click", "selector": ".tool-timeline-raw-btn:not(.hidden)", "label": "收起原始错误数据" },
    { "action": "assert", "expect": "selectorCount", "selector": ".tool-timeline-step.error", "equals": 1 },
    { "action": "click", "selector": ".tool-timeline-nav-btn[data-timeline-nav-direction=\"1\"]", "label": "切到后续画面证据" },
    { "action": "assert", "expect": "navText", "equals": "3/3" },
    { "action": "assert", "expect": "activeText", "includes": "页面截图" },
    { "action": "assert", "expect": "selectorText", "selector": ".tool-timeline-slot", "includes": "保存按钮重新渲染" },
    { "action": "assert", "expect": "noHorizontalOverflow" }
  ]
