        "isError": true
      },
      {
        "type": "tool",
        "_uiKey": "esr-t3",
        "toolCallId": "esr-t3",
        "name": "screenshot",
        "args": { "fullPage": false },
        "result": { "method": "viewport", "width": 1280, "height": 720, "note": "保存按钮重新渲染，页面仍停留在编辑态" }
      }
    ]
